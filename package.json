{
  "name": "cap_service",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "watch-employee": "cds watch --open mastering.fe.employee/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-department": "cds watch --open mastering.fe.department/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-location": "cds watch --open mastering.fe.location/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-category": "cds watch --open mastering.fe.category/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-vendor": "cds watch --open mastering.fe.vendor/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    },
    "odata": {
      "version": "v4",
      "batch": true
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employee",
    "app/department",
    "app/location",
    "app/category",
    "app/vendor"
  ]
}
